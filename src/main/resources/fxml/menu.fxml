<?xml version="1.0" encoding="UTF-8"?>

<!-- ============================================================
     IMPORT
     ============================================================ -->
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<!-- ============================================================
     CONTENITORE RADICE
     StackPane a strati: sfondo sotto, contenuto sopra.
     - fx:controller → MenuController
     - styleClass="root-pane" → stile CSS globale
     ============================================================ -->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unicam.cs.mpgc.rpg.m131177.controller.MenuController"
           styleClass="root-pane">

    <!-- ========================================================
         LIVELLO 1 — SFONDO
         Immagine a tutto schermo (900x700)
         ======================================================== -->
    <ImageView fitWidth="900" fitHeight="700">
        <Image url="@/images/background/wallpaper.jpg"/>
    </ImageView>

    <!-- ========================================================
         LIVELLO 2 — CONTENUTO
         VBox verticale centrata: titolo, spaziatori e pulsanti
         ======================================================== -->
    <VBox alignment="CENTER" spacing="30">

        <!-- Titolo del gioco (stile title-label) -->
        <Label text="SOULS ADVENTURE" styleClass="title-label"/>

        <!-- Spaziatore 40px: separa titolo e pulsanti -->
        <VBox prefHeight="40"/>

        <!-- ====================================================
             PULSANTI DEL MENU
             ==================================================== -->

        <!-- Inizia Partita → handleIniziaPartita() -->
        <Button fx:id="btnIniziaPartita"
                text="▶ Inizia Partita"
                onAction="#handleIniziaPartita"
                styleClass="button"
                prefWidth="300"
                prefHeight="75"/>

        <!-- Statistiche Personali → handleStatistichePersonali() -->
        <Button fx:id="btnStatistichePersonali"
                text="📊 Le mie Statistiche"
                onAction="#handleStatistichePersonali"
                styleClass="button"
                prefWidth="300"
                prefHeight="75"/>

        <!-- Classifica Giocatori → handleStatisticheGlobali() -->
        <Button fx:id="btnStatisticheGlobali"
                text="🏆 Classifica Giocatori"
                onAction="#handleStatisticheGlobali"
                styleClass="button"
                prefWidth="300"
                prefHeight="75"/>

        <!-- Spaziatore 40px finale per bilanciare il layout -->
        <VBox prefHeight="40"/>
    </VBox>
</StackPane>