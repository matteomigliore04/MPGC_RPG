<?xml version="1.0" encoding="UTF-8"?>

<!-- Import JavaFX (ordinati per package) -->
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Contenitore radice: StackPane a strati (sfondo sotto, contenuto sopra) -->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unicam.cs.mpgc.rpg.m131177.controller.MenuController"
           styleClass="root-pane">

    <!-- Sfondo a tutto schermo -->
    <ImageView fitWidth="900" fitHeight="700">
        <Image url="@/images/background/wallpaper.jpg"/>
    </ImageView>

    <!-- Contenuto centrato: titolo, spaziatori e pulsanti -->
    <VBox alignment="CENTER" spacing="30">

        <!-- Titolo del gioco -->
        <Label text="SOULS ADVENTURE" styleClass="title-label"/>

        <!-- Spaziatore tra titolo e pulsanti -->
        <VBox prefHeight="40"/>

        <!-- Pulsante: Inizia Partita -->
        <Button fx:id="btnIniziaPartita"
                text="▶ Inizia Partita"
                onAction="#handleIniziaPartita"
                styleClass="button"
                prefWidth="300"
                prefHeight="75"/>

        <!-- Pulsante: Statistiche Personali -->
        <Button fx:id="btnStatistichePersonali"
                text="📊 Le mie Statistiche"
                onAction="#handleStatistichePersonali"
                styleClass="button"
                prefWidth="300"
                prefHeight="75"/>

        <!-- Pulsante: Classifica Giocatori -->
        <Button fx:id="btnStatisticheGlobali"
                text="🏆 Classifica Giocatori"
                onAction="#handleStatisticheGlobali"
                styleClass="button"
                prefWidth="300"
                prefHeight="75"/>

        <!-- Spaziatore finale per bilanciare il layout -->
        <VBox prefHeight="40"/>

    </VBox>
</StackPane>