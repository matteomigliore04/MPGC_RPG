<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unicam.cs.mpgc.rpg.m131177.controller.MenuController"
           styleClass="root-pane">

    <!-- SFONDO: ImageView come primo figlio (sta sotto tutto) -->
    <ImageView fitWidth="900" fitHeight="700" preserveRatio="false">
        <image>
            <Image url="@/images/Puppet King.png"/>
        </image>
    </ImageView>

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <VBox alignment="CENTER" spacing="30">

        <!-- Titolo del gioco -->
        <Label text="ARCHERY ADVENTURE" styleClass="title-label"/>

        <!-- Spazio vuoto per separare titolo e bottoni -->
        <VBox prefHeight="40"/>

        <!-- Bottone per iniziare la partita -->
        <Button fx:id="btnIniziaPartita"
                text="▶ Inizia Partita"
                onAction="#handleIniziaPartita"
                styleClass="menu-button"
                prefWidth="300"
                prefHeight="75"/>

        <!-- Bottone per le statistiche personali -->
        <Button fx:id="btnStatistichePersonali"
                text="📊 Le mie Statistiche"
                onAction="#handleStatistichePersonali"
                styleClass="menu-button"
                prefWidth="300"
                prefHeight="75"/>

        <!-- Bottone per le statistiche degli altri giocatori -->
        <Button fx:id="btnStatisticheGlobali"
                text="🏆 Classifica Giocatori"
                onAction="#handleStatisticheGlobali"
                styleClass="menu-button"
                prefWidth="300"
                prefHeight="75"/>

        <!-- Footer -->
        <VBox prefHeight="30"/>
        <Label text="v1.2.2 - Progetto MPGC" styleClass="footer-label"/>

    </VBox>

</StackPane>