<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Region?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unicam.cs.mpgc.rpg.m131177.controller.GameController">

    <!-- Immagine di sfondo a tutto schermo (900x700),
         caricata dalla cartella resources/images -->
    <ImageView fitWidth="900" fitHeight="700">
        <Image url="@/images/floor.jpeg"/>
    </ImageView>

    <!-- Area di gioco: il Canvas dove disegneremo player e mostri -->
    <Canvas fx:id="gameCanvas" width="900" height="700" />

    <!-- 3. HUD (Overlay trasparente) -->
    <StackPane prefWidth="900" prefHeight="700"
               style="-fx-background-color: transparent;"
               mouseTransparent="true" pickOnBounds="false">

        <HBox fx:id="hudCenter" spacing="10" alignment="CENTER"
              styleClass="hud-panel"
              StackPane.alignment="TOP_CENTER">

            <!-- ✅ MARGINE CORRETTO -->
            <StackPane.margin>
                <Insets top="20"/>
            </StackPane.margin>

            <!-- Vita a sinistra -->
            <Label fx:id="lblHealth" text="❤️ Vita: 100" styleClass="hud-label-health"/>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- Ondata e Punti a destra -->
            <Label fx:id="lblWave" text="🌊 Ondata: 1" styleClass="hud-label-wave"/>
            <Label fx:id="lblScore" text="⭐ Punti: 0" styleClass="hud-label-score"/>

        </HBox>

    </StackPane>

</StackPane>

