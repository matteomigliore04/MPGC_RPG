<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unicam.cs.mpgc.rpg.m131177.controller.GameController">

    <!-- Immagine di sfondo a tutto schermo (900x700),
         caricata dalla cartella resources/images -->
    <ImageView fitWidth="900" fitHeight="700">
        <Image url="@/images/floor.jpeg"/>
    </ImageView>

    <!-- Area di gioco: il Canvas dove disegneremo player e mostri -->
    <Canvas fx:id="gameCanvas" width="900" height="700" />

    <!-- 3. HUD (Overlay trasparente) -->
    <StackPane prefWidth="900" prefHeight="700"
               style="-fx-background-color: transparent;"
               mouseTransparent="true" pickOnBounds="false">

        <HBox fx:id="hudCenter" spacing="0" alignment="TOP_LEFT"
              styleClass="hud-panel"
              StackPane.alignment="TOP_LEFT">

            <StackPane.margin>
                <Insets top="20" left="20"/>
            </StackPane.margin>

            <VBox spacing="2" alignment="TOP_LEFT">
                <Label fx:id="lblHealth" text="Vita: 100" styleClass="hud-label, hud-label-health"/>
                <Label fx:id="lblArrows" text="Frecce: 100" styleClass="hud-label, hud-label-arrow"/>
                <Label fx:id="lblScore" text="Punti: 0" styleClass="hud-label, hud-label-score"/>
                <Label fx:id="lblWave" text="Ondata: 1" styleClass="hud-label, hud-label-wave"/>
            </VBox>

        </HBox>

    </StackPane>

    <!-- ... (SFONDO, CANVAS, HUD) ... -->

    <!-- MENU DI PAUSA (Overlay) -->
    <VBox fx:id="pauseMenu" alignment="CENTER" spacing="25"
          styleClass="pause-menu-container"
          visible="false" managed="false"
          StackPane.alignment="CENTER">

        <Label text="PAUSA" styleClass="pause-title"/>

        <Button fx:id="btnResume" text="Riprendi Partita"
                onAction="#handleResume" styleClass="pause-button"/>

        <Button fx:id="btnQuit" text="Termina Partita"
                onAction="#handleQuit" styleClass="pause-button"/>
    </VBox>

</StackPane>
