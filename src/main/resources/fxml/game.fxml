<?xml version="1.0" encoding="UTF-8"?>

<!-- Import JavaFX (ordinati per package) -->
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Contenitore radice: StackPane a strati (sfondo → canvas → HUD → menu pausa → game over) -->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unicam.cs.mpgc.rpg.m131177.controller.GameController">

    <!-- Sfondo a tutto schermo -->
    <ImageView fitWidth="900" fitHeight="700">
        <Image url="@/images/background/floor.png"/>
    </ImageView>

    <!-- Canvas di gioco: superficie su cui il GameLoop disegna player, mostri e frecce -->
    <Canvas fx:id="gameCanvas" width="900" height="700" />

    <!-- HUD overlay: trasparente e non intercetta i click (mouseTransparent + pickOnBounds=false) -->
    <AnchorPane prefWidth="900" prefHeight="700"
                style="-fx-background-color: transparent;"
                mouseTransparent="true" pickOnBounds="false">

        <!-- Alto a sinistra: Ondata -->
        <HBox fx:id="hudTopLeft" spacing="15" alignment="CENTER_LEFT"
              AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10">
            <Label fx:id="lblWave" text="Ondata: 1" styleClass="hud-label"/>
        </HBox>

        <!-- Alto a destra: Punti -->
        <HBox fx:id="hudTopRight" spacing="15" alignment="CENTER_RIGHT"
              AnchorPane.topAnchor="10" AnchorPane.rightAnchor="10">
            <Label fx:id="lblScore" text="Punti: 0" styleClass="hud-label"/>
        </HBox>

        <!-- Basso a sinistra: Vita, Scudo, Frecce -->
        <HBox fx:id="hudBottomLeft" spacing="15" alignment="CENTER_LEFT"
              AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10">
            <Label fx:id="lblHealth" text="Vita: 100" styleClass="hud-label"/>
            <Label fx:id="lblShield" text="Scudo: 0" styleClass="hud-label"/>
            <Label fx:id="lblArrows" text="Frecce: 150" styleClass="hud-label"/>
        </HBox>

        <!-- Basso a destra: Pozioni (Cure, Scudi) -->
        <HBox fx:id="hudBottomRight" spacing="15" alignment="CENTER_RIGHT"
              AnchorPane.bottomAnchor="10" AnchorPane.rightAnchor="10">
            <Label fx:id="lblHealthPotions" text="Cure: 0" styleClass="hud-label"/>
            <Label fx:id="lblShieldPotions" text="Scudi: 0" styleClass="hud-label"/>
        </HBox>

    </AnchorPane>

    <!-- Menu di pausa (nascosto all'avvio: visible=false, managed=false) -->
    <VBox fx:id="pauseMenu" alignment="CENTER" spacing="25"
          styleClass="menu-container"
          visible="false" managed="false"
          StackPane.alignment="CENTER">

        <Label text="PAUSA" styleClass="pause-title"/>

        <!-- Riprendi partita -->
        <Button fx:id="btnResume" text="Riprendi partita"
                onAction="#handleResume" styleClass="pause-button"/>

        <!-- Termina partita -->
        <Button fx:id="btnQuit" text="Termina partita"
                onAction="#handleQuit" styleClass="pause-button"/>
    </VBox>

    <!-- Menu game over (nascosto all'avvio: visible=false, managed=false) -->
    <VBox fx:id="gameOverMenu" alignment="CENTER" spacing="20"
          styleClass="menu-container, game-over-container"
          visible="false" managed="false"
          StackPane.alignment="CENTER">

        <Label text="GAME OVER" styleClass="game-over-title"/>
        <Label fx:id="lblFinalScore" text="Punti Finali: 0" styleClass="hud-label-score"/>

        <!-- Ricomincia -->
        <Button fx:id="btnRestart" text="Ricomincia"
                onAction="#handleRestart" styleClass="pause-button"/>

        <!-- Torna al menu principale -->
        <Button fx:id="btnMainMenu" text="Menu Principale"
                onAction="#handleMainMenu" styleClass="pause-button"/>
    </VBox>

</StackPane>