<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unicam.cs.mpgc.rpg.m131177.controller.MonsterController"
           styleClass="root-pane">

    <!-- SFONDO: ImageView come primo figlio (sta sotto tutto).
         Immagine a tutto schermo (900x700) caricata da resources/images -->
    <ImageView fitWidth="900" fitHeight="700">
        <Image url="@/images/Puppet King.png"/>
    </ImageView>

    <!-- VBox principale: dispone verticalmente titolo, sottotitolo,
         griglia 2x2 dei mostri e pulsante "Indietro".
         - maxWidth=600 limita la larghezza per centrare meglio il contenuto -->
    <VBox alignment="TOP_CENTER" spacing="20" maxWidth="600">

        <!-- Titolo della schermata, con margine superiore extra di 30px
             per staccarlo dal bordo e stile "title-label" dal CSS -->
        <Label text="SCEGLI IL NEMICO" styleClass="title-label">
            <VBox.margin>
                <Insets top="30"/>
            </VBox.margin>
        </Label>

        <!-- Sottotitolo in stile narrativo che invita il giocatore a scegliere -->
        <Label text="Quale creatura oserai affrontare con il tuo arco?"
               styleClass="subtitle-label"/>

        <!-- Spaziatore verticale di 20px tra sottotitolo e griglia -->
        <VBox prefHeight="20"/>

        <!-- Contenitore della griglia 2x2 dei mostri:
             due righe (HBox) con due pulsanti ciascuna -->
        <VBox spacing="15" alignment="CENTER">

            <!-- Riga 1: Troll e Ragno Gigante -->
            <HBox spacing="20" alignment="CENTER">
                <!-- Pulsante Troll: lento ma devastante, azione handleTroll() -->
                <Button fx:id="btnTroll"
                        text="Troll&#10;Lento ma devastante"
                        onAction="#handleTroll"
                        styleClass="monster-button"
                        prefWidth="250" prefHeight="80"
                        wrapText="true"/>
                <!-- Pulsante Ragno Gigante: veloce e insidioso, azione handleRagno() -->
                <Button fx:id="btnRagno"
                        text="Ragno Gigante&#10;Veloce e insidioso"
                        onAction="#handleRagno"
                        styleClass="monster-button"
                        prefWidth="250" prefHeight="80"
                        wrapText="true"/>
            </HBox>

            <!-- Riga 2: Cavaliere Nero e Dragone -->
            <HBox spacing="20" alignment="CENTER">
                <!-- Pulsante Cavaliere Nero: armato e pericoloso, azione handleCavaliere() -->
                <Button fx:id="btnCavaliere"
                        text="Cavaliere Nero&#10;Armato e pericoloso"
                        onAction="#handleCavaliere"
                        styleClass="monster-button"
                        prefWidth="250" prefHeight="80"
                        wrapText="true"/>
                <!-- Pulsante Dragone: la sfida definitiva.
                     Applica due classi CSS ("monster-button" + "monster-legendary")
                     per evidenziarlo come mostro leggendario -->
                <Button fx:id="btnDragone"
                        text="Dragone&#10;La sfida definitiva"
                        onAction="#handleDragone"
                        styleClass="monster-button, monster-legendary"
                        prefWidth="250" prefHeight="80"
                        wrapText="true"/>
            </HBox>
        </VBox>

        <!-- Spaziatore verticale di 30px prima del pulsante "Indietro" -->
        <VBox prefHeight="30"/>

        <!-- Pulsante "Torna alla Difficoltà": riporta l'utente alla schermata
             precedente tramite handleIndietro(), con stile "back-button" -->
        <Button fx:id="btnIndietro"
                text="← Torna alla Difficoltà"
                onAction="#handleIndietro"
                styleClass="back-button"
                prefWidth="320" prefHeight="40"/>

    </VBox>

</StackPane>