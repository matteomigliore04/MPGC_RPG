<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unicam.cs.mpgc.rpg.m131177.controller.MonsterController"
           styleClass="root-pane">

    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <VBox alignment="TOP_CENTER" spacing="20" maxWidth="600">

        <!-- Titolo -->
        <Label text="SCEGLI IL NEMICO" styleClass="title-label">
            <VBox.margin>
                <Insets top="30"/>
            </VBox.margin>
        </Label>

        <Label text="Quale creatura oserai affrontare con il tuo arco?"
               styleClass="subtitle-label"/>

        <!-- Spazio -->
        <VBox prefHeight="20"/>

        <!-- Griglia 2x2 dei mostri -->
        <VBox spacing="15" alignment="CENTER">

            <!-- Riga 1: Troll e Ragno -->
            <HBox spacing="20" alignment="CENTER">
                <Button fx:id="btnTroll"
                        text="Troll&#10;Lento ma devastante"
                        onAction="#handleTroll"
                        styleClass="monster-button"
                        prefWidth="250" prefHeight="80"
                        wrapText="true"/>
                <Button fx:id="btnRagno"
                        text="Ragno Gigante&#10;Veloce e insidioso"
                        onAction="#handleRagno"
                        styleClass="monster-button"
                        prefWidth="250" prefHeight="80"
                        wrapText="true"/>
            </HBox>

            <!-- Riga 2: Cavaliere e Dragone -->
            <HBox spacing="20" alignment="CENTER">
                <Button fx:id="btnCavaliere"
                        text="🛡Cavaliere Nero&#10;Armato e pericoloso"
                        onAction="#handleCavaliere"
                        styleClass="monster-button"
                        prefWidth="250" prefHeight="80"
                        wrapText="true"/>
                <Button fx:id="btnDragone"
                        text="Dragone&#10;La sfida definitiva"
                        onAction="#handleDragone"
                        styleClass="monster-button, monster-legendary"
                        prefWidth="250" prefHeight="80"
                        wrapText="true"/>
            </HBox>
        </VBox>

        <!-- Spazio -->
        <VBox prefHeight="30"/>

        <!-- Bottone Indietro -->
        <Button fx:id="btnIndietro"
                text="← Torna alla Difficoltà"
                onAction="#handleIndietro"
                styleClass="back-button"
                prefWidth="220" prefHeight="40"/>

    </VBox>

</StackPane>