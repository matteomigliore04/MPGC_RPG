<?xml version="1.0" encoding="UTF-8"?>

<!-- Import JavaFX (ordinati per package) -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Contenitore radice: StackPane a strati (sfondo sotto, contenuto sopra) -->
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unicam.cs.mpgc.rpg.m131177.controller.DifficultyController"
           styleClass="root-pane">

    <!-- Sfondo a tutto schermo -->
    <ImageView fitWidth="900" fitHeight="700">
        <Image url="@/images/background/wallpaper.jpg"/>
    </ImageView>

    <!-- Contenuto centrato in alto: titolo, sottotitolo, griglia e pulsante indietro -->
    <VBox alignment="TOP_CENTER" spacing="30">

        <!-- Titolo con margine superiore extra -->
        <Label text="SCEGLI LA DIFFICOLTA" styleClass="title-label">
            <VBox.margin>
                <Insets top="30"/>
            </VBox.margin>
        </Label>

        <!-- Sottotitolo esplicativo -->
        <Label text="Ogni difficoltà cambierà la forza e l'astuzia dei nemici"
               styleClass="subtitle-label"/>

        <!-- Spaziatore tra sottotitolo e griglia -->
        <VBox prefHeight="20"/>

        <!-- Griglia pulsanti difficoltà (2x2) -->
        <VBox spacing="15" alignment="CENTER">

            <!-- Riga 1: EASY e MEDIUM -->
            <HBox spacing="20" alignment="CENTER">
                <!-- EASY → handleFacile() -->
                <Button text="EASY&#10;&#10;Per iniziare a giocare"
                        onAction="#handleFacile"
                        styleClass="button, difficulty"
                        prefWidth="250" prefHeight="80"
                        wrapText="true"/>
                <!-- MEDIUM → handleMedia() -->
                <Button text="MEDIUM&#10;&#10;Per una sfida bilanciata"
                        onAction="#handleMedia"
                        styleClass="button, difficulty"
                        prefWidth="250" prefHeight="80"
                        wrapText="true"/>
            </HBox>

            <!-- Riga 2: HARD e EXTREME -->
            <HBox spacing="20" alignment="CENTER">
                <!-- HARD → handleAlta() -->
                <Button text="HARD&#10;&#10;Solo per i veterani"
                        onAction="#handleAlta"
                        styleClass="button, difficulty"
                        prefWidth="250" prefHeight="80"
                        wrapText="true"/>
                <!-- EXTREME → handleSuperiore() -->
                <Button text="EXTREME&#10;&#10;Solo per i più coraggiosi"
                        onAction="#handleSuperiore"
                        styleClass="button, difficulty, difficulty-extreme"
                        prefWidth="250" prefHeight="80"
                        wrapText="true"/>
            </HBox>
        </VBox>

        <!-- Spaziatore prima del pulsante Indietro -->
        <VBox prefHeight="30"/>

        <!-- Pulsante Torna al Menu → handleIndietro() -->
        <Button text="← Torna al Menu"
                onAction="#handleIndietro"
                styleClass="back-button"
                prefWidth="320" prefHeight="40"/>
    </VBox>

</StackPane>