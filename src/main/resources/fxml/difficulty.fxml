<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unicam.cs.mpgc.rpg.m131177.controller.DifficultyController"
           styleClass="root-pane">

    <!-- Immagine di sfondo a tutto schermo (900x700),
         caricata dalla cartella resources/images -->
    <ImageView fitWidth="900" fitHeight="700">
        <Image url="@/images/Puppet King.png"/>
    </ImageView>

    <!-- VBox principale: dispone verticalmente titolo, sottotitolo,
         griglia di pulsanti e pulsante "Indietro", centrati in alto -->
    <VBox alignment="TOP_CENTER" spacing="20">

        <!-- Titolo della schermata, con margine superiore extra di 30px
             per staccarlo dal bordo e stile "title-label" dal CSS -->
        <Label text="SCEGLI LA DIFFICOLTA" styleClass="title-label">
            <VBox.margin>
                <Insets top="30"/>
            </VBox.margin>
        </Label>

        <!-- Sottotitolo esplicativo: spiega che la difficoltà
             influenzerà forza e astuzia dei nemici -->
        <Label text="Ogni difficoltà cambierà la forza e l'astuzia dei nemici"
               styleClass="subtitle-label"/>

        <!-- Spaziatore verticale di 20px tra sottotitolo e griglia -->
        <VBox prefHeight="20"/>

        <!-- Contenitore della griglia dei pulsanti di difficoltà:
             due righe (HBox) con due pulsanti ciascuna -->
        <VBox spacing="15" alignment="CENTER">

            <!-- Prima riga: FACILE e MEDIA -->
            <HBox spacing="20" alignment="CENTER">
                <!-- Pulsante FACILE: testo su due righe grazie a \n (&#10;),
                     azione collegata a handleFacile() nel controller -->
                <Button text="FACILE&#10;&#10;Per chi inizia l'avventura"
                        onAction="#handleFacile"
                        styleClass="difficulty-button"
                        prefWidth="250" prefHeight="80"
                        wrapText="true"/>
                <!-- Pulsante MEDIA: sfida bilanciata, azione handleMedia() -->
                <Button text="MEDIA&#10;&#10;Sfida bilanciata"
                        onAction="#handleMedia"
                        styleClass="difficulty-button"
                        prefWidth="250" prefHeight="80"
                        wrapText="true"/>
            </HBox>

            <!-- Seconda riga: ALTA e SUPERIORE -->
            <HBox spacing="20" alignment="CENTER">
                <!-- Pulsante ALTA: per veterani, azione handleAlta() -->
                <Button text="ALTA&#10;&#10;Solo per veterani"
                        onAction="#handleAlta"
                        styleClass="difficulty-button"
                        prefWidth="250" prefHeight="80"
                        wrapText="true"/>
                <!-- Pulsante SUPERIORE: applica due classi CSS
                     ("difficulty-button" + "difficulty-extreme") per
                     evidenziarlo come livello più estremo -->
                <Button text="SUPERIORE&#10;&#10;Per i più coraggiosi"
                        onAction="#handleSuperiore"
                        styleClass="difficulty-button, difficulty-extreme"
                        prefWidth="250" prefHeight="80"
                        wrapText="true"/>
            </HBox>
        </VBox>

        <!-- Spaziatore verticale di 30px prima del pulsante "Indietro" -->
        <VBox prefHeight="30"/>

        <!-- Pulsante "Torna al Menu": riporta l'utente al menu principale
             tramite handleIndietro() nel controller, con stile "back-button" -->
        <Button text="← Torna al Menu"
                onAction="#handleIndietro"
                styleClass="back-button"
                prefWidth="320" prefHeight="40"/>
    </VBox>

</StackPane>